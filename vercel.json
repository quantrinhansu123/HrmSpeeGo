{
  "functions": {
    "api/leave-accrual.js": {
      "maxDuration": 60
    },
    "api/attendance-match.js": {
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/leave-accrual", "schedule": "5 17 * * *" }],
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
